# Copy this file to .env and fill in your real key. .env is gitignored —
# never commit it.
#
# Get a key from https://build.nvidia.com (NVIDIA NIM). Keys start with "nvapi-".
#
# LiteLLM's nvidia_nim provider reads NVIDIA_NIM_API_KEY specifically — that
# exact variable name is required for any nvidia_nim/... model string to work.
NVIDIA_NIM_API_KEY=nvapi-your-key-here

# Kept as a plain alias for any tooling/scripts that read this name instead.
# Same value as above.
NVIDIA_API_KEY=nvapi-your-key-here
