# Copy this file to .env and fill in your real key. .env is gitignored —
# never commit it.
#
# The active pool uses OpenRouter. Get a key from https://openrouter.ai/keys;
# keys start with "sk-or-". NVIDIA credentials are optional while NIM entries
# remain inactive.
#
# LiteLLM's NVIDIA NIM provider reads NVIDIA_NIM_API_KEY specifically if you
# activate any nvidia_nim/... model entries.
NVIDIA_NIM_API_KEY=nvapi-your-key-here

# Kept as a plain alias for any tooling/scripts that read this name instead.
# Same value as above.
NVIDIA_API_KEY=nvapi-your-key-here

# Get a key from https://openrouter.ai/keys (OpenRouter). Keys start with "sk-or-".
# Only required for openrouter/... models; NIM models keep using the key above.
OPENROUTER_API_KEY=sk-or-your-key-here
